{
  "$schema": "https://deno.land/x/deno/cli/schemas/config-file.v1.json",
  "nodeModulesDir": "auto",
  "workspace": [
    "./packages/common",
    "./packages/ui",
    "./packages/websocket",
    "./apps/server",
    "./apps/web",
    "./apps/visualizer"
  ],
  "exclude": ["apps/web", "apps/visualizer", ".devenv"],
  "compilerOptions": {
    "lib": ["ESNext"],
    "module": "Preserve",
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "allowUnusedLabels": false,
    "allowUnreachableCode": false,
    "checkJs": true
  },
  "tasks": {
    "build": "deno task build:web && deno task build:visualizer && deno task build:server",
    "build:server": "cd apps/server && deno task build",
    "build:visualizer": "cd apps/visualizer && deno task build",
    "build:web": "cd apps/web && deno task build",
    "check": "deno check packages/common/src packages/ui/src packages/websocket/src apps/server/src apps/server/scripts",
    "db-generate": "cd apps/server && deno task db:generate",
    "db-migrate": "cd apps/server && deno task db:migrate",
    "db-push": "cd apps/server && deno task db:push",
    "dev": "deno task dev:web",
    "dev:panel:db": "cd apps/server && deno task db:studio",
    "dev:panel:server": "cd apps/server && deno task dev",
    "dev:panel:visualizer": "cd apps/visualizer && deno task dev",
    "dev:panel:web": "cd apps/web && deno task dev",
    "dev:prepare": "deno run -A ./scripts/dev/prepare.ts",
    "dev:server": "deno task dev:prepare && deno task dev:panel:server",
    "dev:visualizer": "deno run -A npm:concurrently@^9.2.1 \"deno task dev:server\" \"deno task dev:panel:visualizer\"",
    "dev:web": "deno run -A npm:concurrently@^9.2.1 \"deno task dev:server\" \"deno task dev:panel:web\"",
    "dev:web:noauth": "IGNORE_LOGIN=true deno task dev:web",
    "openapi": "cd apps/server && deno task openapi",
    "start": "cd apps/server && deno run -A src/index.ts",
    "sync": "deno task db-generate && deno task openapi",
    "tsc": "deno task check"
  }
}
