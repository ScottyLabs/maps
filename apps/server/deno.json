{
  "tasks": {
    "dev": "PORT=3001 deno run --allow-all --watch src/index.ts",
    "build": "deno compile --frozen --no-check --allow-all --cached-only --include src --include prisma --output dist/bin/cmumaps-server src/index.ts",
    "db:generate": "deno run -A npm:prisma@^6.18.0 generate",
    "db:migrate": "deno run -A npm:prisma@^6.18.0 migrate deploy",
    "db:push": "deno run -A npm:prisma@^6.18.0 db push",
    "db:studio": "deno run -A npm:prisma@^6.18.0 studio",
    "openapi": "deno run -A scripts/generate-openapi.ts"
  },
  "imports": {
    "@elysia/static": "npm:@elysia/static@^1.4.11",
    "@elysiajs/openapi": "npm:@elysiajs/openapi@^1.4.15",
    "@logtape/elysia": "npm:@logtape/elysia@^2.2.1",
    "@logtape/logtape": "npm:@logtape/logtape@^2.2.4",
    "@panva/openid-client": "npm:openid-client@^6.8.4",
    "@prisma/adapter-pg": "npm:@prisma/adapter-pg@^6.19.3",
    "@prisma/client": "npm:@prisma/client@^6.19.3",
    "@sinclair/typebox": "npm:@sinclair/typebox@0.34.49",
    "elysia": "npm:elysia@^1.4.29",
    "jose": "npm:jose@^6.1.0",
    "openapi-typescript": "npm:openapi-typescript@^7.10.1",
    "tinyqueue": "npm:tinyqueue@^3.0.0"
  },
  "compilerOptions": {
    "lib": ["ESNext", "deno.window"],
    "module": "Preserve",
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": false,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": false,
    "allowUnusedLabels": false,
    "allowUnreachableCode": false,
    "checkJs": true
  }
}
