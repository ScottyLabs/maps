# Per-developer values for the operator-run dataflow job (cp .env.example .env).
# Everything the server needs comes from secretspec/devenv, not from here.
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Target server for `uv run populate-database`, e.g. https://cmumaps.com
SERVER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
