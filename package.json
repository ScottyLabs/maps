{
  "name": "cmumaps",
  "version": "0.0.0",
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@types/bun": "^1.3.5",
    "@types/web": "^0.0.279",
    "husky": "^8.0.3",
    "markdownlint-cli2": "^0.20.0",
    "syncpack": "^13.0.4",
    "turbo": "^2.7.4",
    "typescript": "^5.9.3"
  },
  "packageManager": "bun@1.3.5",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "check": "turbo check",
    "db:populate": "python3 scripts/dev/dev.py populate",
    "dev": "python3 scripts/dev/dev.py start",
    "dev:auth": "python3 scripts/dev/dev.py start",
    "dev:server": "turbo dev --filter=@cmumaps/server",
    "dev:visualizer": "turbo dev --filter=@cmumaps/visualizer --filter=@cmumaps/server",
    "dev:web": "turbo dev --filter=@cmumaps/web --filter=@cmumaps/server",
    "dev:web:host": "turbo dev:host --filter=@cmumaps/web --filter=@cmumaps/server",
    "dev:web:noauth": "IGNORE_LOGIN=true VITE_IGNORE_LOGIN=true turbo dev --env-mode=loose --filter=@cmumaps/web --filter=@cmumaps/server",
    "preinstall": "bunx only-allow bun",
    "prepare": "husky && husky install",
    "secrets:pull": "python3 scripts/dev/dev.py secrets",
    "start": "turbo start",
    "sync": "cd apps/server && bun run db-generate && bun run tsoa && bun run openapi",
    "syncpack": "syncpack lint",
    "syncpack:fix": "syncpack format && syncpack fix-mismatches",
    "syncpack:update": "syncpack update",
    "tsc": "turbo tsc"
  },
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
